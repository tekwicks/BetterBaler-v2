# Local Government Website Configuration
# Copy this file to .env.local and update with your government's information

# Government Information
VITE_GOVERNMENT_NAME="Baler"
VITE_GOVERNMENT_TYPE="Municipality"
VITE_REGION="Region III"
VITE_PROVINCE="Aurora"

# Website Information
VITE_WEBSITE_URL="https://baler.gov.ph"
VITE_CONTACT_EMAIL="info@baler.gov.ph"
VITE_CONTACT_PHONE="(042) 123-4567"

# Social Media (Optional)
VITE_FACEBOOK_URL="https://facebook.com/lgubaler"
VITE_TWITTER_URL="https://twitter.com/lgubaler"
VITE_INSTAGRAM_URL="https://instagram.com/lgubaler"
VITE_YOUTUBE_URL="https://youtube.com/lgubaler"

# SEO
VITE_SITE_DESCRIPTION="Official website of the Municipality of Baler"
VITE_SITE_KEYWORDS="government, local government, services, baler, aurora"
VITE_OG_IMAGE_URL="https://baler.gov.ph/og-image.jpg"
VITE_TWITTER_HANDLE="@lgubaler"

# Analytics (Optional)
VITE_GOOGLE_ANALYTICS_ID=""
VITE_FACEBOOK_PIXEL_ID=""

# Meilisearch (Optional)
VITE_MEILISEARCH_HOST=""
VITE_MEILISEARCH_SEARCH_KEY=""
